# ================================
# OpenAI Configuration
# ================================

# ================================
# LLM API Keys
# ================================
OPENAI_API_KEY=your-openai-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# ================================
# LangSmith Configuration (Optional)
# ================================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=grant-writer-agent

# ================================
# Application Configuration
# ================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_RELOAD=true

# Uvicorn/gunicorn worker count for parallel layer runs (start_api_parallel.sh)
WORKERS=20
GUNICORN_TIMEOUT=360

# ================================
# Chatbot Configuration
# ================================
# MySQL database (optional - for grant search)
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/tgp

# Vector store for RAG
VECTOR_STORE_PROVIDER=chroma
CHROMA_PATH=agents/chatbot/data/chroma_db

# (Optional) Pinecone - for future use
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX_NAME=tgp-product-docs

# Chatbot settings
MAX_CONVERSATION_HISTORY=10
MAX_SEARCH_RESULTS=10
SUPPORT_EMAIL=support@thegrantportal.com

# ================================
# Grant Writer v2 Configuration
# ================================

# OpenRouter (LLM gateway for all v2 layers)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SerpAPI (Layer 1 URL discovery)
SERPAPI_API_KEY=your-serpapi-api-key-here

# MySQL database (shared with v1 — same DATABASE_URL)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/tgp

# Layer 2 cost & safety caps (these are the defaults — override as needed)
V2_L2_MAX_ITERATIONS=12
V2_L2_MAX_PAGES=25
V2_L2_MAX_PDFS=5
V2_L2_MAX_BYTES=8388608
V2_L2_MAX_COST_USD=0.50

# Per-layer model overrides (defaults shown — any OpenRouter model ID accepted)
V2_MODEL_LAYER1_RERANKER=openai/gpt-4o-mini
V2_MODEL_LAYER2_AGENT=anthropic/claude-sonnet-4
V2_MODEL_LAYER2_PROGRAM_IDENTIFIER=openai/gpt-4o
V2_MODEL_LAYER2_RULE_EVALUATOR=openai/gpt-4o-mini
V2_MODEL_LAYER3_EXTRACTOR=openai/gpt-4o-mini
V2_MODEL_LAYER4_PER_PROGRAM=openai/gpt-4o
V2_MODEL_LAYER4_CONSOLIDATOR=openai/gpt-4o-mini
V2_MODEL_LAYER5_SEO=openai/gpt-4o-mini

# Jina Reader — JS-render fallback for JS/SPA foundation sites. Used by BOTH the
# v2 pipeline (Layer 2) and the v1 pipeline scraper: when static fetch + trafilatura
# come back empty/thin, the page is re-fetched through r.jina.ai as clean markdown.
JINA_API_KEY=your-jina-api-key-here
JINA_TIMEOUT=60

# HTTP client settings (optional)
V2_HTTP_TIMEOUT=30
V2_HTTP_MAX_RETRIES=3
V2_CACHE_DIR=agents/grant_writer_v2/.cache

# v1 pipeline agents (/api/v1/pipeline/complete — CMS "Fetch New Content With AI").
# GPT-5.x: custom temperature is ignored (model requires default).
PIPELINE_MODEL=gpt-5.5

# Model split: per-page extraction (~85% of calls) runs on the cheap tier;
# gpt-5.4-mini is ~6.7x cheaper than gpt-5.5 ($0.75/$4.50 vs $5/$30 per 1M tokens).
PIPELINE_EXTRACT_MODEL=gpt-5.4-mini

# Writer tier for the subscriber-facing content (description + teaser/subscriber
# title). gpt-5.4 ($2.5/$15) writes this at ~1/3 the cost of gpt-5.5 ($5/$30);
# set to gpt-5.5 to A/B quality. Teaser output is rule-checked with one retry
# regardless of tier.
PIPELINE_WRITER_MODEL=gpt-5.4

# Client decision 2026-08-14: consolidated description + teaser are written
# manually by the client's team, so generation is OFF by default. The fetch
# still populates grants, org info, contact card, SEO fields and the
# subscriber title; description/teaser come back as empty strings. Set true
# to restore full generation (adds the two writer calls, ~$0.09-0.14/fetch).
PIPELINE_GENERATE_DESCRIPTIONS=false

# Reasoning effort split: extraction is high-volume (one call per page) and stays
# cheap; the two synthesis calls (consolidated description + teaser/metadata) are
# low-volume and quality-critical, so they run at a higher effort for ChatGPT-grade output.
PIPELINE_REASONING_EFFORT=low
PIPELINE_WRITER_REASONING_EFFORT=high

# Raw page text fed to the writers so they work from the source, not only the
# extracted JSON. Per-page cap and total source-corpus cap (characters) — the
# corpus cap bounds BOTH writer prompts (description and teaser/metadata).
PIPELINE_PAGE_TEXT_CHARS=12000
PIPELINE_SOURCE_CORPUS_CHARS=48000

# Pages with less readable text than this skip the LLM extraction call (nav
# shells, stubs). Contact signals and sub-links are still harvested from them.
PIPELINE_MIN_PAGE_CHARS=500

# Cap on text sent into one extraction call (Jina can return 40k+ chars of
# link-farm markdown; substance fits well inside this).
PIPELINE_EXTRACT_INPUT_CHARS=20000

# Org-extraction input caps: per page and combined total (characters). An
# uncapped join of JS-heavy pages once hit 1.2M tokens and OpenAI's 272k
# input limit rejected the call, failing the whole fetch.
PIPELINE_ORG_PAGE_CHARS=20000
PIPELINE_ORG_INPUT_CHARS=60000

# Metadata is two parallel calls: teaser + subscriber title on PIPELINE_MODEL
# (quality-critical, corpus-grounded up to this many chars); the 4 SEO fields
# (title/h1/meta title/meta description) on PIPELINE_EXTRACT_MODEL.
PIPELINE_TEASER_CORPUS_CHARS=12000

# Second crawl wave: program sub-pages linked from wave-1 pages (award caps and
# deadlines usually live there, one level below the homepage). 0 disables.
PIPELINE_WAVE2_PAGES=8

# Crawler identity sent when scraping foundation sites (pipeline + v2 fetcher).
# Set the contact URL to the environment's portal (e.g. https://www.tgp-dev.com on dev).
BOT_USER_AGENT="TheGrantPortalBot/1.0 (+https://www.thegrantportal.com)"
