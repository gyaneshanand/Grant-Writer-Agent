# ================================
# OpenAI Configuration
# ================================

# ================================
# LLM API Keys
# ================================
OPENAI_API_KEY=your-openai-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# ================================
# LangSmith Configuration (Optional)
# ================================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=grant-writer-agent

# ================================
# Application Configuration
# ================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_RELOAD=true

# Uvicorn/gunicorn worker count for parallel layer runs (start_api_parallel.sh)
WORKERS=20
GUNICORN_TIMEOUT=360

# ================================
# Chatbot Configuration
# ================================
# MySQL database (optional - for grant search)
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/tgp

# Vector store for RAG
VECTOR_STORE_PROVIDER=chroma
CHROMA_PATH=agents/chatbot/data/chroma_db

# (Optional) Pinecone - for future use
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX_NAME=tgp-product-docs

# Chatbot settings
MAX_CONVERSATION_HISTORY=10
MAX_SEARCH_RESULTS=10
SUPPORT_EMAIL=support@thegrantportal.com

# ================================
# Grant Writer v2 Configuration
# ================================

# OpenRouter (LLM gateway for all v2 layers)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SerpAPI (Layer 1 URL discovery)
SERPAPI_API_KEY=your-serpapi-api-key-here

# MySQL database (shared with v1 — same DATABASE_URL)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/tgp

# Layer 2 cost & safety caps (these are the defaults — override as needed)
V2_L2_MAX_ITERATIONS=12
V2_L2_MAX_PAGES=25
V2_L2_MAX_PDFS=5
V2_L2_MAX_BYTES=8388608
V2_L2_MAX_COST_USD=0.50

# Per-layer model overrides (defaults shown — any OpenRouter model ID accepted)
V2_MODEL_LAYER1_RERANKER=openai/gpt-4o-mini
V2_MODEL_LAYER2_AGENT=anthropic/claude-sonnet-4
V2_MODEL_LAYER2_PROGRAM_IDENTIFIER=openai/gpt-4o
V2_MODEL_LAYER2_RULE_EVALUATOR=openai/gpt-4o-mini
V2_MODEL_LAYER3_EXTRACTOR=openai/gpt-4o-mini
V2_MODEL_LAYER4_PER_PROGRAM=openai/gpt-4o
V2_MODEL_LAYER4_CONSOLIDATOR=openai/gpt-4o-mini
V2_MODEL_LAYER5_SEO=openai/gpt-4o-mini

# Jina Reader (JS-rendering fallback for Layer 2 — get key at jina.ai)
JINA_API_KEY=your-jina-api-key-here

# HTTP client settings (optional)
V2_HTTP_TIMEOUT=30
V2_HTTP_MAX_RETRIES=3
V2_CACHE_DIR=agents/grant_writer_v2/.cache

# v1 pipeline agents (/api/v1/pipeline/complete — CMS "Fetch New Content With AI").
# GPT-5.x: custom temperature is ignored (model requires default).
PIPELINE_MODEL=gpt-5.5

# Crawler identity sent when scraping foundation sites (pipeline + v2 fetcher).
# Set the contact URL to the environment's portal (e.g. https://www.tgp-dev.com on dev).
BOT_USER_AGENT="TheGrantPortalBot/1.0 (+https://www.thegrantportal.com)"
